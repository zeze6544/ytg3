# Public (bundled into the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only (set the same values in Vercel project env)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deploy (bun run deploy)
VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_NAME=narcodex
# Comma-separated production hosts to attach after deploy:
# VERCEL_ALIASES=www.example.com,app.example.com,api.example.com
